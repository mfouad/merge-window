<aside class="connect" aria-labelledby="connect-h">
<div><p class="eyebrow">{{ site.connect.call.eyebrow }}</p><h2 id="connect-h">{{ site.connect.call.title }}</h2><p>{{ site.connect.call.text }}</p><a class="btn amber" href="{{ site.calendar }}" rel="noopener">{% include "icons/calendar.svg" %}Book a call</a></div>
<div><p class="eyebrow">{{ site.connect.follow.eyebrow }}</p><h2>{{ site.connect.follow.title }}</h2><p>{{ site.connect.follow.text }}</p><a class="btn ghost" href="{{ site.linkedin }}" rel="noopener">{% include "icons/linkedin.svg" %}Follow on LinkedIn</a></div>
</aside>
