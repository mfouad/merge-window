---
layout: layouts/base.njk
section: posts
---
<div class="art-head"><div class="wrap">
<p class="eyebrow">{{ eyebrow }}</p>
<h1>{{ title }}</h1>
<p class="dek">{{ dek }}</p>
<div class="byline"><span>By {{ site.author }}</span>{% if factsChecked %}<span>Facts checked {{ factsChecked | longDate }}</span>{% endif %}<span>~{{ content | readingTime }} min read</span></div>
</div></div>

<nav class="toc-mobile" aria-label="Sections"></nav>

<div class="layout">
<aside class="toc" aria-label="On this page">
<p class="eyebrow">On this page</p>
<ol></ol>
</aside>

<article class="prose">
{%- if tldr %}
<div class="tldr">
<p class="eyebrow">TL;DR</p>
<ul>{% for item in tldr %}<li>{{ item | mdi | safe }}</li>{% endfor %}</ul>
</div>
{%- endif %}
{{ content | safe }}
<div class="after-parts">
<div class="cta-inline">{% include "connect.njk" %}</div>
{%- if question %}
<p class="small">{{ question }}</p>
{%- endif %}
</div>
</article>
</div>

<script>
(function(){
  var links=[].slice.call(document.querySelectorAll('.toc a'));
  if(!('IntersectionObserver' in window)||!links.length)return;
  var map={};links.forEach(function(a){map[a.getAttribute('href').slice(1)]=a});
  var io=new IntersectionObserver(function(es){es.forEach(function(e){
    if(e.isIntersecting){links.forEach(function(l){l.classList.remove('on')});var a=map[e.target.id];if(a)a.classList.add('on')}
  })},{rootMargin:'-90px 0px -65% 0px'});
  Object.keys(map).forEach(function(id){var el=document.getElementById(id);if(el)io.observe(el)});
})();
</script>
